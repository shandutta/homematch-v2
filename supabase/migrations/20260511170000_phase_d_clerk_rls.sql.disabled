-- =============================================================================
-- Phase D of Clerk migration: RLS policies → Clerk-aware
-- =============================================================================
--
-- *** DO NOT RUN UNTIL PREREQUISITE IS MET ***
--
-- This file ends in .disabled to prevent accidental execution. To apply:
--   1. Enable Supabase third-party auth integration with Clerk
--      (Supabase Dashboard → Authentication → Providers → Third-Party Auth
--      → Clerk → enable + paste Clerk JWKS URL).
--      Docs: https://supabase.com/docs/guides/auth/third-party/clerk
--   2. Rename this file to remove the .disabled suffix:
--      mv 20260511170000_phase_d_clerk_rls.sql.disabled \
--         20260511170000_phase_d_clerk_rls.sql
--   3. Run `pnpm supabase db reset` (or `supabase db push`).
--
-- WHY DISABLED: Without the third-party auth integration enabled,
-- auth.uid() and auth.jwt() reflect Supabase Auth users only. Running this
-- migration before then would lock all existing Supabase users out of their
-- own data (their RLS policies would no longer match because their UUID
-- in user_profiles.clerk_user_id would be NULL).
--
-- ROLLOUT ORDER:
--   1. Run Phase E: backfill clerk_user_id for existing Supabase users.
--   2. Enable third-party auth integration in Supabase Dashboard.
--   3. Run this migration.
--   4. Verify: a Clerk user should be able to view/edit their own data;
--      another user's data should be invisible.
--
-- BACKGROUND
--   Pre-Clerk: auth.uid() returned the Supabase auth.users UUID, which was
--     also user_profiles.id (direct FK match). Policies were straightforward.
--   Post-Clerk: auth.uid() returns the Clerk userId (string like
--     "user_2xY...") via the JWT 'sub' claim. user_profiles.id is still a
--     UUID. Direct comparison fails. We resolve via clerk_user_id.
--
-- STRATEGY
--   Define a SECURITY DEFINER helper `public.current_user_profile_id()`
--   that resolves the calling JWT's sub claim to user_profiles.id. All
--   policies switch from `auth.uid() = X` to `current_user_profile_id() = X`.
--
--   The helper is marked STABLE so the planner can fold it into the query
--   once per statement, preserving the perf win from the earlier
--   `(select auth.uid())` optimization.
--
-- =============================================================================

BEGIN;

-- -----------------------------------------------------------------------------
-- Helper: resolve calling Clerk user to user_profiles.id
-- -----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.current_user_profile_id()
RETURNS uuid
LANGUAGE sql
STABLE
SECURITY INVOKER
SET search_path = public, auth
AS $$
  SELECT id
  FROM public.user_profiles
  WHERE clerk_user_id = (auth.jwt() ->> 'sub')
  LIMIT 1
$$;

COMMENT ON FUNCTION public.current_user_profile_id() IS
  'Phase D Clerk-aware helper: maps current request JWT.sub (Clerk userId) to user_profiles.id. Returns NULL when no profile is linked. STABLE so it folds to a single evaluation per query.';

GRANT EXECUTE ON FUNCTION public.current_user_profile_id() TO authenticated;
GRANT EXECUTE ON FUNCTION public.current_user_profile_id() TO anon;

-- -----------------------------------------------------------------------------
-- user_property_interactions (5 policies)
-- -----------------------------------------------------------------------------
DROP POLICY IF EXISTS "Users can view their own interactions" ON public.user_property_interactions;
CREATE POLICY "Users can view their own interactions" ON public.user_property_interactions
  FOR SELECT USING ((SELECT public.current_user_profile_id()) = user_id);

DROP POLICY IF EXISTS "Users can insert their own interactions" ON public.user_property_interactions;
CREATE POLICY "Users can insert their own interactions" ON public.user_property_interactions
  FOR INSERT WITH CHECK ((SELECT public.current_user_profile_id()) = user_id);

DROP POLICY IF EXISTS "Users can update their own interactions" ON public.user_property_interactions;
CREATE POLICY "Users can update their own interactions" ON public.user_property_interactions
  FOR UPDATE USING ((SELECT public.current_user_profile_id()) = user_id);

DROP POLICY IF EXISTS "Users can delete their own interactions" ON public.user_property_interactions;
CREATE POLICY "Users can delete their own interactions" ON public.user_property_interactions
  FOR DELETE USING ((SELECT public.current_user_profile_id()) = user_id);

DROP POLICY IF EXISTS "Household members can access mutual likes function" ON public.user_property_interactions;
CREATE POLICY "Household members can access mutual likes function" ON public.user_property_interactions
  FOR SELECT
  USING (
    household_id IN (
      SELECT household_id
      FROM public.user_profiles
      WHERE id = (SELECT public.current_user_profile_id())
    )
  );

-- -----------------------------------------------------------------------------
-- user_profiles (4+ policies)
-- -----------------------------------------------------------------------------
DROP POLICY IF EXISTS "Users can view own profile" ON public.user_profiles;
CREATE POLICY "Users can view own profile" ON public.user_profiles
  FOR SELECT USING ((SELECT public.current_user_profile_id()) = id);

DROP POLICY IF EXISTS "Users can update own profile" ON public.user_profiles;
CREATE POLICY "Users can update own profile" ON public.user_profiles
  FOR UPDATE USING ((SELECT public.current_user_profile_id()) = id);

DROP POLICY IF EXISTS "Users can insert own profile" ON public.user_profiles;
CREATE POLICY "Users can insert own profile" ON public.user_profiles
  FOR INSERT WITH CHECK ((SELECT public.current_user_profile_id()) = id);

DROP POLICY IF EXISTS "Users can delete own profile" ON public.user_profiles;
CREATE POLICY "Users can delete own profile" ON public.user_profiles
  FOR DELETE USING ((SELECT public.current_user_profile_id()) = id);

-- -----------------------------------------------------------------------------
-- saved_searches (4 policies)
-- -----------------------------------------------------------------------------
DROP POLICY IF EXISTS "Users can view their own saved searches" ON public.saved_searches;
CREATE POLICY "Users can view their own saved searches" ON public.saved_searches
  FOR SELECT USING ((SELECT public.current_user_profile_id()) = user_id);

DROP POLICY IF EXISTS "Users can insert their own saved searches" ON public.saved_searches;
CREATE POLICY "Users can insert their own saved searches" ON public.saved_searches
  FOR INSERT WITH CHECK ((SELECT public.current_user_profile_id()) = user_id);

DROP POLICY IF EXISTS "Users can update their own saved searches" ON public.saved_searches;
CREATE POLICY "Users can update their own saved searches" ON public.saved_searches
  FOR UPDATE USING ((SELECT public.current_user_profile_id()) = user_id);

DROP POLICY IF EXISTS "Users can delete their own saved searches" ON public.saved_searches;
CREATE POLICY "Users can delete their own saved searches" ON public.saved_searches
  FOR DELETE USING ((SELECT public.current_user_profile_id()) = user_id);

-- -----------------------------------------------------------------------------
-- households (membership policies — use user_profiles.household_id)
-- -----------------------------------------------------------------------------
DROP POLICY IF EXISTS "Household members can view household" ON public.households;
CREATE POLICY "Household members can view household" ON public.households
  FOR SELECT USING (
    id IN (
      SELECT household_id
      FROM public.user_profiles
      WHERE id = (SELECT public.current_user_profile_id())
    )
  );

DROP POLICY IF EXISTS "Household creators can update household" ON public.households;
CREATE POLICY "Household creators can update household" ON public.households
  FOR UPDATE USING (created_by = (SELECT public.current_user_profile_id()));

DROP POLICY IF EXISTS "Authenticated users can create households" ON public.households;
CREATE POLICY "Authenticated users can create households" ON public.households
  FOR INSERT WITH CHECK (
    (SELECT public.current_user_profile_id()) IS NOT NULL
    AND created_by = (SELECT public.current_user_profile_id())
  );

-- -----------------------------------------------------------------------------
-- household_invitations (creator + invitee policies)
-- -----------------------------------------------------------------------------
DROP POLICY IF EXISTS "Household members can view invitations" ON public.household_invitations;
CREATE POLICY "Household members can view invitations" ON public.household_invitations
  FOR SELECT USING (
    household_id IN (
      SELECT household_id
      FROM public.user_profiles
      WHERE id = (SELECT public.current_user_profile_id())
    )
  );

DROP POLICY IF EXISTS "Household members can create invitations" ON public.household_invitations;
CREATE POLICY "Household members can create invitations" ON public.household_invitations
  FOR INSERT WITH CHECK (
    created_by = (SELECT public.current_user_profile_id())
    AND household_id IN (
      SELECT household_id
      FROM public.user_profiles
      WHERE id = (SELECT public.current_user_profile_id())
    )
  );

DROP POLICY IF EXISTS "Inviters can update their invitations" ON public.household_invitations;
CREATE POLICY "Inviters can update their invitations" ON public.household_invitations
  FOR UPDATE USING (created_by = (SELECT public.current_user_profile_id()));

DROP POLICY IF EXISTS "Inviters can delete their invitations" ON public.household_invitations;
CREATE POLICY "Inviters can delete their invitations" ON public.household_invitations
  FOR DELETE USING (created_by = (SELECT public.current_user_profile_id()));

-- -----------------------------------------------------------------------------
-- household_property_resolutions (4 policies)
-- -----------------------------------------------------------------------------
DROP POLICY IF EXISTS "Household members can view resolutions" ON public.household_property_resolutions;
CREATE POLICY "Household members can view resolutions" ON public.household_property_resolutions
  FOR SELECT USING (
    household_id IN (
      SELECT household_id
      FROM public.user_profiles
      WHERE id = (SELECT public.current_user_profile_id())
    )
  );

DROP POLICY IF EXISTS "Household members can create resolutions" ON public.household_property_resolutions;
CREATE POLICY "Household members can create resolutions" ON public.household_property_resolutions
  FOR INSERT WITH CHECK (
    resolved_by = (SELECT public.current_user_profile_id())
    AND household_id IN (
      SELECT household_id
      FROM public.user_profiles
      WHERE id = (SELECT public.current_user_profile_id())
    )
  );

DROP POLICY IF EXISTS "Household members can update resolutions" ON public.household_property_resolutions;
CREATE POLICY "Household members can update resolutions" ON public.household_property_resolutions
  FOR UPDATE USING (
    household_id IN (
      SELECT household_id
      FROM public.user_profiles
      WHERE id = (SELECT public.current_user_profile_id())
    )
  );

DROP POLICY IF EXISTS "Household members can delete resolutions" ON public.household_property_resolutions;
CREATE POLICY "Household members can delete resolutions" ON public.household_property_resolutions
  FOR DELETE USING (
    household_id IN (
      SELECT household_id
      FROM public.user_profiles
      WHERE id = (SELECT public.current_user_profile_id())
    )
  );

-- -----------------------------------------------------------------------------
-- admin_role_assignments (admins see/manage their own assignment)
-- -----------------------------------------------------------------------------
DROP POLICY IF EXISTS "Users can view their own role assignment" ON public.admin_role_assignments;
CREATE POLICY "Users can view their own role assignment" ON public.admin_role_assignments
  FOR SELECT USING (user_id = (SELECT public.current_user_profile_id()));

-- =============================================================================
-- VERIFICATION QUERIES (run after applying)
-- =============================================================================
-- 1. As an authenticated Clerk user with a linked user_profiles row:
--      SELECT public.current_user_profile_id();   -- should return their UUID
--      SELECT * FROM public.user_profiles WHERE id = public.current_user_profile_id();
--    should return exactly one row.
--
-- 2. SELECT count(*) FROM public.user_property_interactions
--      WHERE user_id != public.current_user_profile_id();   -- should be 0
--      (RLS hides others' interactions).
--
-- 3. Check the advisor:
--      Supabase Dashboard → Database → Linter — should report 0 auth_rls_initplan issues.
--
-- =============================================================================

COMMIT;
