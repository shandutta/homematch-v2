{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.{ts,tsx}",
    "src/app/**/layout.{ts,tsx}",
    "src/app/**/route.{ts,tsx}",
    "src/app/**/loading.{ts,tsx}",
    "src/app/**/error.{ts,tsx}",
    "src/app/**/not-found.{ts,tsx}",
    "src/app/**/template.{ts,tsx}",
    "src/middleware.ts",
    "middleware.ts",
    "pages/**/*.{ts,tsx}",
    "next.config.{js,ts,mjs}",
    "instrumentation.{ts,js}",
    "src/instrumentation.{ts,js}",
    "scripts/**/*.{js,ts,mjs,cjs}",
    "__tests__/**/*.{test,spec}.{ts,tsx,js,jsx}",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest.globalSetup.ts",
    "jest.config.js",
    "jest.setup.ts",
    "jest.preload.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,js,mjs,cjs}"],
  "ignore": [
    "supabase/migrations/**",
    "homematch-original-analysis/**",
    "v1-reference/**",
    ".claude/worktrees/**",
    "reports/**",
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "@types/*",
    "eslint-*",
    "prettier",
    "ts-node",
    "concurrently",
    "cross-env",
    "@faker-js/faker",
    "@lhci/cli",
    "chrome-devtools-mcp",
    "pg",
    "shadcn",
    "supabase",
    "tailwindcss",
    "tw-animate-css",
    "vite-tsconfig-paths"
  ],
  "ignoreBinaries": [
    "shellcheck"
  ],
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
