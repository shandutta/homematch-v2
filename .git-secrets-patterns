# Custom secret patterns for git-secrets
# - One regex per line
# - Lines starting with # are comments
# - Blank lines are ignored
#
# Install: brew install git-secrets
# Add patterns: git secrets --add-provider -- cat .git-secrets-patterns

# Clerk
sk_live_[A-Za-z0-9]{20,}
sk_test_[A-Za-z0-9]{20,}
clerk_secret_[A-Za-z0-9_-]{20,}

# Supabase service-role JWTs (legacy + new) and admin keys
eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}
sb_secret_[A-Za-z0-9_-]{20,}
sbp_[A-Za-z0-9]{20,}

# OpenRouter / OpenAI / Anthropic
sk-or-[A-Za-z0-9_-]{20,}
sk-[A-Za-z0-9]{32,}
sk-ant-[A-Za-z0-9_-]{20,}

# Google API (Maps, Gemini)
AIza[0-9A-Za-z_-]{35}

# RapidAPI keys (long hex prefix + msh + suffix)
[0-9a-f]{40,}msh[0-9a-f]+p[0-9a-f]+

# Generic high-entropy assignments
(?:secret|token|password|api[_-]?key)\s*[:=]\s*[A-Za-z0-9_/+=-]{24,}
